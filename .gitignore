# Output (generated files — do not commit)
output/*
!output/.gitkeep
benchmark/results/*.csv
benchmark/results/*.md
!benchmark/results/.gitkeep
benchmark/sessions/
*.drawio.bak

# Per-project workspace data (scaffold on demand via `archharness init-project`)
projects/

# Legacy single-project input (may contain sensitive diagrams or documents)
input/*
!input/.gitkeep


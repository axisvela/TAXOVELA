# ── Interactions ──────────────────────────────────────

aliyun_business_vpc.business_az_a.CMP_01 -> aliyun_business_vpc.business_data.CMP_03: "P-JDBC\n(AU-P1)"
aliyun_business_vpc.business_az_b.CMP_02 -> aliyun_business_vpc.business_data.CMP_03: "P-JDBC\n(AU-P1)"
aliyun_business_vpc.business_az_a.CMP_01 -> aliyun_business_vpc.business_data.CMP_04: "P-HTTPS\n(AU-I1)"
aliyun_business_vpc.business_az_a.CMP_01 -> dc_primary.dc_intranet.CMP_05: "P-HTTPS\n(AU-C1)"
dc_primary.dc_intranet.CMP_05 -> dc_primary.dc_intranet.CMP_06: "P-JDBC\n(AU-P1)"

# ── Security declarations ─────────────────────────
# Key Management [private_dc]: Enterprise vault for ERP credentials; automated rotation
# Key Management [other]: KMS 凭据管家 with per-class CMKs for the database and the bucket
# User Auth (Internal): INF-18 | Enterprise IdP / SAML 2.0 with MFA, federated to RAM SSO

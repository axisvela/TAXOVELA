            fill: "#8E24AA"
            stroke: "#6A1B9A"
            font-color: "#FFFFFF"
            stroke-dash: 5
            bold: true
          }
    }
    CMP_05: "⚠ CMP-05 Outbound gateway\nn/a - configuration, nginx; version · VM" {

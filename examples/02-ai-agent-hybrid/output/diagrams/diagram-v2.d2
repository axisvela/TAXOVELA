# ── Interactions ──────────────────────────────────────

user -> dc_cn_primary.dc_cn_primary_app_zone.CMP_01: "P-HTTPS"
dc_cn_primary.dc_cn_primary_app_zone.CMP_01 -> dc_cn_primary.dc_cn_primary_app_zone.CMP_02: "P-HTTPS"
dc_cn_primary.dc_cn_primary_app_zone.CMP_01 -> dc_cn_primary.dc_cn_primary_app_zone.CMP_03: "P-HTTPS\n(AU-X2)"
dc_cn_primary.dc_cn_primary_app_zone.CMP_02 -> dc_cn_primary.dc_cn_primary_db_zone.CMP_04: "P-TCP"
dc_cn_primary.dc_cn_primary_app_zone.CMP_03 -> dc_cn_primary.dc_cn_primary_db_zone.CMP_04: "P-TCP"
dc_cn_primary.dc_cn_primary_app_zone.CMP_02 -> dc_cn_primary.dc_cn_primary_app_zone.CMP_05: "P-HTTPS\n(AU-X2)"
dc_cn_primary.dc_cn_primary_app_zone.CMP_05 -> azure_eastus.azure_eastus_edw_spoke.CMP_06: "P-HTTPS"
dc_cn_primary.dc_cn_primary_app_zone.CMP_05 -> azure_eastus2.azure_eastus2_private_endpoint.CMP_07: "P-HTTPS\n(AU-P3)"
dc_cn_primary.dc_cn_primary_app_zone.CMP_01 -> dc_cn_primary.dc_cn_primary_app_zone.INF_05: "P-HTTPS\n(AU-T3)"
user -> azure_global_identity.azure_global_identity_zone.INF_07: "P-HTTPS"
dc_cn_primary -> azure_eastus: "P-PRIVATE"
dc_cn_primary -> azure_eastus2: "P-PRIVATE"

# ── Security declarations ─────────────────────────
# Key Management [private_dc]: Internal K8s Kubernetes Secrets encrypted at rest for pod credentials; approved CMP-05 VM secret delivery/store TBD; least-privilege RBAC, injection, and rotation required; no hardcoded secrets
# Key Management [azure]: Provider-side controls remain outside the integration boundary; CMP-06 credential mechanism and any Azure Key Vault ownership are TBD
# User Auth (Internal): INF-05 ADFS / SAML 2.0 fallback
# User Auth (External): INF-07 Microsoft Entra ID / Redirect-based federated sign-in - exact protocol TBD

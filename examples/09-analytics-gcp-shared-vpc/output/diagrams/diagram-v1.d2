# Analytics API (ANA) - Google Cloud Shared VPC and On-Premises Hybrid
# ID: ANA-GCP-001-TechDiagram-V1.0  |  Platform: hybrid_cloud  |  Version: V1.0  |  Owner team: Data Platform  |  Author: TBD  |  Last modified: 2026-09-24

direction: right

internet: Internet {
  shape: cloud
  style {
    fill: "#E8E8E8"
  }
}

gcp_host_project: "Google Cloud host project [REGION] [InfraSec]" {
  shape: cloud
  style {
    fill: "#FAFAFA"
    stroke: "#1A73E8"
    stroke-width: 2
  }

  gcp_ingress_subnet: "Shared ingress subnet" {
    style {
      fill: "#FAFAFA"
      stroke: "#BDBDBD"
      stroke-dash: 6
    }

    INF_08: "INF-08 | Cloud Armor\nGoogle Cloud managed service" {
      shape: hexagon
      style {
            fill: "#D32F2F"
            stroke: "#D32F2F"
            font-color: "#FFFFFF"
          }
    }
    INF_09: "INF-09 | Global HTTPS load balancer\nGoogle Cloud managed service" {
      style {
            fill: "#D32F2F"
            stroke: "#D32F2F"
            font-color: "#FFFFFF"
          }
    }
  }

  gcp_egress_subnet: "Shared egress subnet" {
    style {
      fill: "#FAFAFA"
      stroke: "#BDBDBD"
      stroke-dash: 6
    }

    INF_10: "INF-10 | Cloud NAT\nGoogle Cloud managed service" {
      shape: hexagon
      style {
            fill: "#D32F2F"
            stroke: "#D32F2F"
            font-color: "#FFFFFF"
          }
    }
    INF_11: "INF-11 | Cloud Interconnect\nGoogle Cloud managed service" {
      shape: hexagon
      style {
            fill: "#D32F2F"
            stroke: "#D32F2F"
            font-color: "#FFFFFF"
          }
    }
  }

  gcp_app_subnet: "Private runtime subnet" {
    style {
      fill: "#FAFAFA"
      stroke: "#BDBDBD"
      stroke-dash: 6
    }

    CMP_01: "⚠ CMP-01 | Analytics API\ngo-1.23, net/http · K8s" {
      style {
            fill: "#8E24AA"
            stroke: "#6A1B9A"
            font-color: "#FFFFFF"
            stroke-dash: 5
            bold: true
          }
    }
    CMP_02: "⚠ CMP-02 | Analytics worker\npython-3.12 · K8s" {
      style {
            fill: "#8E24AA"
            stroke: "#6A1B9A"
            font-color: "#FFFFFF"
            stroke-dash: 5
            bold: true
          }
    }
  }

  gcp_data_subnet: "Private data subnet" {
    style {
      fill: "#FAFAFA"
      stroke: "#BDBDBD"
      stroke-dash: 6
    }

    CMP_03: "⚠ CMP-03 | BigQuery warehouse" {
      shape: cylinder
      style {
            fill: "#D32F2F"
            stroke: "#D32F2F"
            font-color: "#FFFFFF"
            bold: true
          }
    }
    CMP_04: "⚠ CMP-04 | Cloud Storage stage" {
      style {
            fill: "#D32F2F"
            stroke: "#D32F2F"
            font-color: "#FFFFFF"
            bold: true
          }
    }
    INF_12: "INF-12 | Secret Manager\nGoogle Cloud managed service" {
      shape: oval
      style {
            fill: "#D32F2F"
            stroke: "#D32F2F"
            font-color: "#FFFFFF"
          }
    }
  }

}

dc_primary: "Primary DC [CN] [InfraSec]" {
  shape: rectangle
  style {
    fill: "#FAFAFA"
    stroke: "#444444"
    stroke-width: 2
    double-border: true
  }

  dc_intranet: "Intranet" {
    style {
      fill: "#F3E5F5"
      stroke: "#7B1FA2"
      stroke-dash: 6
    }

    CMP_05: "⚠ CMP-05 | ERP extract service\nK8s" {
      shape: parallelogram
      style {
            fill: "#FFFFFF"
            stroke: "#000000"
            font-color: "#000000"
            bold: true

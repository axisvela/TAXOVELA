# ── Interactions ──────────────────────────────────────

user -> power_platform_tenant.pp_prod_env.CMP_01: "P-HTTPS\n(AU-T2)"
power_platform_tenant.pp_prod_env.CMP_01 -> power_platform_tenant.pp_prod_env.CMP_02: "P-HTTPS"
power_platform_tenant.pp_prod_env.CMP_02 -> power_platform_tenant.pp_prod_env.CMP_03: "P-HTTPS\n(AU-T1)"
power_platform_tenant.pp_prod_env.CMP_02 -> dc_primary.dc_dmz.CMP_04: "P-HTTPS\n(AU-P1)"
dc_primary.dc_dmz.CMP_04 -> dc_primary.dc_app_zone.CMP_06: "P-JDBC\n(AU-P1)"
dc_primary.dc_dmz.CMP_04 -> dc_primary.dc_app_zone.INF_10: "P-HTTPS\n(AU-C1)"
power_platform_tenant.pp_governance.INF_04 -> power_platform_tenant.pp_prod_env.CMP_01: "P-HTTPS\n(AU-T2)"

# ── Security declarations ─────────────────────────
# Key Management [private_dc]: Enterprise vault holds and rotates the gateway service account secret
# Key Management [other]: Entra ID app registrations use certificate credentials; no client secrets
# User Auth (Internal): INF-04 | Entra ID / OIDC with MFA and conditional access

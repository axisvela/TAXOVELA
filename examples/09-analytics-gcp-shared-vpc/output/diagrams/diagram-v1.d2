      style {
            fill: "#FFFFFF"
            stroke: "#000000"
            font-color: "#000000"
          }
    }
  }

}

# ── Interactions ──────────────────────────────────────

internet -> gcp_host_project.gcp_ingress_subnet.INF_08: "P-HTTPS\n(AU-T2)"
gcp_host_project.gcp_ingress_subnet.INF_08 -> gcp_host_project.gcp_ingress_subnet.INF_09: "P-HTTPS"
gcp_host_project.gcp_ingress_subnet.INF_09 -> gcp_host_project.gcp_app_subnet.CMP_01: "P-HTTPS\n(AU-T1)"
gcp_host_project.gcp_app_subnet.CMP_01 -> gcp_host_project.gcp_data_subnet.CMP_03: "P-HTTPS+P-gRPC\n(AU-I1)"
gcp_host_project.gcp_app_subnet.CMP_02 -> gcp_host_project.gcp_data_subnet.CMP_04: "P-HTTPS\n(AU-I1)"
gcp_host_project.gcp_app_subnet.CMP_02 -> gcp_host_project.gcp_data_subnet.INF_12: "P-HTTPS\n(AU-I2)"
gcp_host_project.gcp_app_subnet.CMP_02 -> dc_primary.dc_intranet.CMP_05: "P-HTTPS\n(AU-C1)"
dc_primary.dc_intranet.CMP_05 -> dc_primary.dc_intranet.CMP_06: "P-JDBC\n(AU-P1)"
user -> dc_primary.dc_intranet.INF_13: "P-HTTPS"

# ── Security declarations ─────────────────────────
# Key Management [private_dc]: Enterprise vault for ERP credentials; automated rotation
# Key Management [other]: Cloud KMS with CMEK for BigQuery and Cloud Storage; Secret Manager for runtime credentials
# User Auth (Internal): INF-12 | Enterprise directory / SAML 2.0 with MFA, federated to Cloud Identity
# User Auth (External): INF-12 | Enterprise directory / OIDC / OAuth2.0 Authorization Code with PKCE

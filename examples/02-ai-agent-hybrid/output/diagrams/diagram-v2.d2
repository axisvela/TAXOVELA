# ID: DAP-001-TechDiagram-V1.0  |  Platform: hybrid_cloud  |  Version: V1.0  |  Owner team: TBD  |  Author: TBD  |  Last modified: 2026-09-14

direction: right

internet: Internet {
  shape: cloud
  style {
    fill: "#E8E8E8"
  }
}

